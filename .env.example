# Database
DATABASE_URL=postgresql+asyncpg://travel_user:travel_pass@postgres:5432/travel_db

# LLM Providers (at least one required)
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
CEREBRAS_API_KEY=

# Weather API (optional)
OPENWEATHER_API_KEY=

# Discord webhook (optional)
DISCORD_WEBHOOK_URL=

# JWT Secret (must be at least 32 chars)
JWT_SECRET_KEY=

LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=smart-travel-planner